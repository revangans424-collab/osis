# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_DRIVE_FOLDER_ID: Target Google Drive Folder ID for PADMAWIJAYA 2026/2027.
GOOGLE_DRIVE_FOLDER_ID="1wbDKQg9NERyBeqEMXldgQxq-UZF6z0cQ"

# GOOGLE_SHEETS_SPREADSHEET_ID: Configurable Spreadsheet ID for attendance reporting.
GOOGLE_SHEETS_SPREADSHEET_ID=""

# GOOGLE_SERVICE_ACCOUNT_JSON: JSON string of Google Cloud Service Account with Drive & Sheets API access.
# Configure this in AI Studio Secrets (never put credentials in frontend code).
